# ===========================================================================
# 1. Local Server Configurations (vLLM & Embeddings) - FIRST SECTION
# ===========================================================================
USE_LOCAL_LLM=true
LOCAL_LLM_BASE_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=Qwen/Qwen2.5-7B-Instruct
LOCAL_LLM_TIMEOUT_MS=5000

USE_LOCAL_EMBEDDINGS=true
LOCAL_EMBED_BASE_URL=http://localhost:8001/v1
LOCAL_EMBED_MODEL=bge-small-en-v1.5
LOCAL_EMBED_TIMEOUT_MS=5000

# ===========================================================================
# 2. Cloud API Keys (Fallback Section) - SECOND SECTION
# ===========================================================================
ANTHROPIC_API_KEY=sk-ant-api...
OPENAI_API_KEY=sk-...
PERPLEXITY_API_KEY=pplx-...

# ===========================================================================
# 3. Supabase Configurations - THIRD SECTION
# ===========================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...   # anon / publishable key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=eyJhbGci...   # service_role key

# ===========================================================================
# 4. Other Configurations (Job Workers, OAuth, Connectors, Billing)
# ===========================================================================
NODE_ENV=development
USE_MOCKS=false
WORKER_SECRET=a-long-random-secret-string

# OAuth providers (optional - configure in Supabase Dashboard → Auth → Providers)
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Google OAuth (Required for Google Drive connector)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Dropbox (Required for Dropbox connector)
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=

# Stripe (Required for billing)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
