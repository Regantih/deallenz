# DealLens environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets to git.
#
# Full documentation: see ENV.md

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
NODE_ENV=development

# Set to 'true' to allow mock classes in non-production environments (staging).
# All mock classes throw if NODE_ENV=production AND USE_MOCKS != 'true'.
USE_MOCKS=true

# Override the local mock storage root (default: /tmp/deallenz-mock-storage)
# MOCK_STORAGE_ROOT=/tmp/deallenz-mock-storage

# ---------------------------------------------------------------------------
# Supabase — browser-safe (exposed to client bundle via NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------
# These map to the build-spec names SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY.
# The NEXT_PUBLIC_ prefix is required for Next.js to include them in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...   # anon / publishable key

# ---------------------------------------------------------------------------
# Supabase — server-only (NEVER prefix with NEXT_PUBLIC_)
# SUPABASE_URL is the same value as NEXT_PUBLIC_SUPABASE_URL; set it separately
# so server code can read it without coupling to the NEXT_PUBLIC_ naming.
# SUPABASE_SECRET_KEY is the service_role key — it bypasses RLS.
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=eyJhbGci...   # service_role key — NEVER expose to browser

# ---------------------------------------------------------------------------
# OAuth providers (configure in Supabase Dashboard → Auth → Providers)
# ---------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# LLM providers (PR#5 — leave blank to use MockModelRouter)
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Data connectors (PR#5)
# ---------------------------------------------------------------------------
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=
# NOTION_INTEGRATION_TOKEN=
# FIRECRAWL_API_KEY=
# TAVILY_API_KEY=
