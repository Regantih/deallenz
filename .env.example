# DealLens environment variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any file containing real secrets to git.
#
# Full documentation: see ENV.md
# PR7 status: Supabase + Anthropic are REAL. All others are stubs.

# ---------------------------------------------------------------------------
# Runtime mode
# ---------------------------------------------------------------------------
NODE_ENV=development

# USE_MOCKS: allows mock classes in non-production environments (local/staging).
# MockModelRouter and MockStorageClient throw in production unless USE_MOCKS=true.
# NOTE: Supabase and Anthropic paths no longer have USE_MOCKS fallbacks —
# they are always real when credentials are set.
# USE_MOCKS=true

# Override the local mock storage root (default: /tmp/deallenz-mock-storage)
# MOCK_STORAGE_ROOT=/tmp/deallenz-mock-storage

# ---------------------------------------------------------------------------
# Supabase — browser-safe (exposed to client bundle via NEXT_PUBLIC_ prefix)
# STATUS: REAL (PR7) — set in Vercel for all environments
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGci...   # anon / publishable key

# ---------------------------------------------------------------------------
# Supabase — server-only (NEVER prefix with NEXT_PUBLIC_)
# SUPABASE_URL: same value as NEXT_PUBLIC_SUPABASE_URL; needed for server code.
# SUPABASE_SECRET_KEY: service_role key — bypasses RLS — NEVER expose to browser.
# STATUS: REAL (PR7) — set in Vercel for Production + Preview
# ---------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=eyJhbGci...   # service_role key

# ---------------------------------------------------------------------------
# Anthropic — server-only
# STATUS: REAL (PR7) — set in Vercel for Production + Preview
# Throws 'ANTHROPIC_API_KEY missing - configure in Vercel env vars before deploying'
# if absent when AnthropicModelRouter is instantiated.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Jobs worker secret — server-only
# STATUS: Set in Vercel. Used by POST /api/jobs/worker to authenticate cron calls.
# ---------------------------------------------------------------------------
WORKER_SECRET=a-long-random-secret-string

# ---------------------------------------------------------------------------
# OAuth providers (configure in Supabase Dashboard → Auth → Providers)
# ---------------------------------------------------------------------------
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# OpenAI — NOT YET SET (stub throws if called)
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Perplexity — NOT YET SET (stub throws if called)
# ---------------------------------------------------------------------------
# PERPLEXITY_API_KEY=pplx-...

# ---------------------------------------------------------------------------
# Google OAuth — NOT YET SET
# Required for Google Drive connector (lib/connectors/google-drive.ts).
# Throws '[deallenz] Google Drive connector is not configured' if called.
# ---------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Dropbox — NOT YET SET
# Required for Dropbox connector (lib/connectors/dropbox.ts).
# Throws '[deallenz] Dropbox connector is not configured' if called.
# ---------------------------------------------------------------------------
# DROPBOX_APP_KEY=
# DROPBOX_APP_SECRET=

# ---------------------------------------------------------------------------
# Stripe — NOT YET SET
# Required for billing (lib/stripe.ts).
# Throws '[deallenz] Stripe is not configured' if called.
# ---------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_ID=price_...
